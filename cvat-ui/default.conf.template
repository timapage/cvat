server {
    listen 80;
    # serve the built UI
    root /usr/share/nginx/html;
    index index.html;

    # CVAT UI is a SPA: route unknown paths to index.html
    location / {
        try_files $uri /index.html;
    }
    API_ORIGIN=https://cvat-production.up.railway.app
    # Proxy all API calls to the backend (set API_ORIGIN in Railway)
    location /api/ {
        proxy_pass https://cvat-production.up.railway.app/api/;           # e.g. https://cvat-production.up.railway.app
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_buffering off;
    }
}
